CREATE OR REPLACE PROCEDURE "GADMIN"."USP_CS_VALIDATE_JUSO_KEYWORD" 
(
    IN p_raw_keyword VARCHAR(255),   -- »ç¿ëÀÚ ÀÔ·Â ¿øº» °Ë»ö¾î
    OUT p_validation_code INTEGER,   -- 0: OK, 1: °æ°í (Warning), -1: ¿À·ù (Error)
    OUT p_validation_message VARCHAR(500) -- »ç¿ëÀÚ¿¡°Ô º¸¿©ÁÙ ¸Þ½ÃÁö
)
P1: BEGIN
    DECLARE v_trimmed_keyword VARCHAR(255);
    DECLARE v_is_numeric_only INTEGER;
    DECLARE v_contains_special_char INTEGER;
    DECLARE v_is_sql_injection_attempt INTEGER;

    -- ÃÊ±âÈ­
    SET p_validation_code = 0;
    SET p_validation_message = '°Ë»ö¾î¸¦ »ç¿ëÇØµµ ¾ÈÀüÇÕ´Ï´Ù.';

    -- 1. ¾ÕµÚ °ø¹é Á¦°Å
    SET v_trimmed_keyword = TRIM(p_raw_keyword);

    -- 2. °Ë»ö¾î°¡ ºñ¾ú°Å³ª ³Ê¹« ÂªÀº °æ¿ì (¿À·ù Ã³¸®)
    IF v_trimmed_keyword IS NULL OR LENGTH(v_trimmed_keyword) < 2 THEN
        SET p_validation_code = -1; -- ¿À·ù ÄÚµå
        SET p_validation_message = '? ¿À·ù: °Ë»ö¾î¸¦ 2±ÛÀÚ ÀÌ»ó ÀÔ·ÂÇØÁÖ¼¼¿ä.';
        RETURN;
    END IF;

    -- 3. ¼ýÀÚ·Î¸¸ ±¸¼ºµÇ¾î ÀÖ´ÂÁö ÆÇ´Ü (°æ°í ´ë»ó)
    -- ¿ì¸® ¸¸µç IS_NUMBER_UDF ÇÔ¼ö È°¿ë. (½ºÅ°¸¶¸í ²À ³Ö¾îÁà¾ß ÇÔ!)
    SET v_is_numeric_only = GADMIN.USF_CS_ISNUMBER(v_trimmed_keyword);

    IF v_is_numeric_only = 1 THEN
        SET p_validation_code = 1; -- °æ°í ÄÚµå
        SET p_validation_message = '?? °æ°í: ÀÔ·ÂµÈ ³»¿ëÀÌ ¼ýÀÚ·Î¸¸ µÇ¾î ÀÖ½À´Ï´Ù. °Ç¹° ¹øÈ£ÀÏ °æ¿ì Á¤È®ÇÑ ÁÖ¼Ò °Ë»öÀÌ ¾î·Á¿ï ¼ö ÀÖ½À´Ï´Ù.';
        RETURN; -- °æ°í ¸Þ½ÃÁö´Â ÇÏ³ª¸¸ º¸³»¹Ç·Î ¹Ù·Î ¸®ÅÏ. ¿©·¯ °æ°í¸¦ º¸³»°í ½ÍÀ¸¸é RETURN »èÁ¦ ÈÄ p_validation_message¿¡ ¸Þ½ÃÁöµé ÇÕÄ¡±â.
    END IF;

    -- 4. SQL ¸í·É¾î Æ÷ÇÔ ¿©ºÎ ÆÇ´Ü (SQL Injection ÀÇ½É -> °æ°í/¿À·ù Ã³¸®)
    -- °£´ÜÇÑ Å°¿öµå Ã¼Å© (AND, OR, SELECT, DELETE, DROP µî)
    -- ÀÌ ºÎºÐÀº ¿Ïº®ÇÑ SQL Injection ¹æÁö´Â ¸øÇÔ. ¹æÁö´Â PREPARED STATEMENT°¡ ÇÙ½É!
    -- ´ë¼Ò¹®ÀÚ ±¸ºÐ ¾øÀÌ Ã¼Å©ÇÏ±â À§ÇØ LOWER ÇÔ¼ö »ç¿ë
    SET v_is_sql_injection_attempt = 0;

    IF LOCATE(LOWER(v_trimmed_keyword), ' or ') > 0 OR
       LOCATE(LOWER(v_trimmed_keyword), ' and ') > 0 OR
       LOCATE(LOWER(v_trimmed_keyword), ' select ') > 0 OR
       LOCATE(LOWER(v_trimmed_keyword), ' delete ') > 0 OR
       LOCATE(LOWER(v_trimmed_keyword), ' drop ') > 0 OR
       LOCATE(LOWER(v_trimmed_keyword), ' update ') > 0 OR
       LOCATE(LOWER(v_trimmed_keyword), ' insert ') > 0 OR
       LOCATE(v_trimmed_keyword, ';') > 0 OR -- ´ÙÁß SQL ¸í·É ½Ãµµ
       LOCATE(v_trimmed_keyword, '--') > 0 THEN -- ÁÖ¼® Ã³¸® ½Ãµµ
        SET v_is_sql_injection_attempt = 1;
    END IF;

    IF v_is_sql_injection_attempt = 1 THEN
        SET p_validation_code = -1; -- ¿À·ù ÄÚµå (ÀÌ°Ç °æ°íº¸´Ù´Â À§ÇèÇÑ ½Ãµµ·Î ÆÇ´Ü)
        SET p_validation_message = '? ¿À·ù: SQL ¸í·É¾î ¶Ç´Â Æ¯¼ö ¹®ÀÚ°¡ Æ÷ÇÔµÈ °Ë»ö¾î´Â Çã¿ëµÇÁö ¾Ê½À´Ï´Ù.';
        RETURN;
    END IF;

    -- 5. ÀÏ¹ÝÀûÀÎ Æ¯¼ö¹®ÀÚ Æ÷ÇÔ ¿©ºÎ ÆÇ´Ü (°æ°í ´ë»ó)
    -- ÁÖ¼Ò¿¡ ÈçÈ÷ ¾²ÀÌ´Â Æ¯¼ö¹®ÀÚ (¿¹: -,(),/,.,#,')´Â Á¦¿ÜÇÏ°í °Ë»ç.
    -- Á¤±Ô½ÄÀ» Áö¿øÇÏ´Â DB2 ¹öÀü (10.5 ÀÌ»ó)¿¡¼­´Â REGEXP_LIKE È°¿ë
    -- `[^°¡-ÆRa-zA-Z0-9\s.,()-/]` : ÇÑ±Û, ¿µ¹®, ¼ýÀÚ, °ø¹é, . , ( ) - / ¸¦ Á¦¿ÜÇÑ ¸ðµç ¹®ÀÚ
    -- ÀÌ·± ÆÐÅÏÀÌ ¹ß°ßµÇ¸é Æ¯¼ö¹®ÀÚ°¡ Æ÷ÇÔµÈ °ÍÀ¸·Î °£ÁÖ.
    SET v_contains_special_char = 0;
    IF REGEXP_LIKE(v_trimmed_keyword, '[^°¡-ÆRa-zA-Z0-9\\s.,()\\-/]') = 1 THEN -- v10.5ºÎÅÍ´Â \\°¡ ÇÊ¿äÇÒ ¼ö ÀÖÀ½
         SET v_contains_special_char = 1;
    END IF;

    IF v_contains_special_char = 1 THEN
        -- ÀÌ¹Ì ¼ýÀÚ·Î¸¸ ±¸¼ºµÇ¾î ÀÖ´Ù´Â °æ°í°¡ ³ª°¬À¸¸é µ¤¾î¾²Áö ¾ÊÀ½
        -- ¸¸¾à ¿©·¯ °æ°í¸¦ ÇÑ ¸Þ½ÃÁö¿¡ ´ã°í ½Í´Ù¸é p_validation_message = p_validation_message || ' ±×¸®°í Æ¯¼ö¹®ÀÚµµ Æ÷ÇÔµÊ' ÀÌ·± ½ÄÀ¸·Î Ãß°¡
        IF p_validation_code = 0 THEN -- ¾ÆÁ÷ °æ°í³ª ¿À·ù°¡ ¾ø¾úÀ» ¶§¸¸
            SET p_validation_code = 1; -- °æ°í ÄÚµå
            SET p_validation_message = '?? °æ°í: °Ë»ö¾î¿¡ Æ¯¼ö¹®ÀÚ°¡ Æ÷ÇÔµÇ¾î ÀÖ½À´Ï´Ù. °Ë»ö °á°ú°¡ ¿¹»ó°ú ´Ù¸¦ ¼ö ÀÖ½À´Ï´Ù.';
        END IF;
    END IF;

    -- ÃÖÁ¾ ¹ÝÈ¯ ¸Þ½ÃÁö°¡ ºñ¾îÀÖ´Ù¸é, OK
    IF p_validation_code = 0 THEN
        SET p_validation_message = '°Ë»ö¾î À¯È¿¼º °Ë»ç ¿Ï·á.';
    END IF;

END P1 